// Reglas de seguridad de Firestore.
//
// - Solo pueden leer y escribir quienes entran con un correo de Google verificado que tenga su
//   documento en la colección "allowed" (un documento por correo, con el correo como ID).
//   Los documentos de "allowed" se crean a mano en la consola de Firebase: la app no puede crearlos.
// - Cada tipo de documento solo acepta los campos que la app usa y con el tipo y tamaño esperados;
//   cualquier otra cosa se rechaza.
//
// Se publican en Firebase Console → Firestore Database → Reglas.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verificado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function autorizado() {
      return verificado()
        && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email));
    }

    function textoHasta(valor, max) {
      return valor is string && valor.size() <= max;
    }

    function eventoValido() {
      let e = request.resource.data;
      return e.keys().hasOnly(['titulo', 'fecha', 'inicio', 'fin', 'color', 'nota', 'repite', 'por', 'creado', 'actualizado'])
        && e.titulo is string && e.titulo.size() > 0 && e.titulo.size() <= 120
        && e.fecha is string && e.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('inicio' in e) || textoHasta(e.inicio, 5))
        && (!('fin' in e) || textoHasta(e.fin, 5))
        && (!('color' in e) || textoHasta(e.color, 40))
        && (!('nota' in e) || textoHasta(e.nota, 500))
        && (!('por' in e) || textoHasta(e.por, 40))
        && (!('repite' in e) || e.repite in ['', 'semanal', 'mensual', 'anual']);
    }

    function tareaValida() {
      let t = request.resource.data;
      return t.keys().hasOnly(['texto', 'hecha', 'hechaPor', 'por', 'orden', 'ocu', 'creado', 'actualizado'])
        && t.texto is string && t.texto.size() > 0 && t.texto.size() <= 120
        && t.hecha is bool
        && (!('hechaPor' in t) || textoHasta(t.hechaPor, 40))
        && (!('por' in t) || textoHasta(t.por, 40))
        && (!('orden' in t) || t.orden is number)
        && (!('ocu' in t) || textoHasta(t.ocu, 10));
    }

    function compraValida() {
      let c = request.resource.data;
      return c.keys().hasOnly(['nombre', 'cantidad', 'comprado', 'archivado', 'veces', 'por', 'compradoPor', 'creado', 'actualizado'])
        && c.nombre is string && c.nombre.size() > 0 && c.nombre.size() <= 80
        && c.comprado is bool
        && (!('cantidad' in c) || textoHasta(c.cantidad, 20))
        && (!('archivado' in c) || c.archivado is bool)
        && (!('veces' in c) || c.veces is number)
        && (!('por' in c) || textoHasta(c.por, 40))
        && (!('compradoPor' in c) || textoHasta(c.compradoPor, 40));
    }

    match /allowed/{email} {
      allow get: if verificado() && request.auth.token.email == email;
    }

    match /eventos/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && eventoValido();

      // Lista de tareas de cada evento.
      match /tareas/{tid} {
        allow read, delete: if autorizado();
        allow create, update: if autorizado() && tareaValida();
      }
    }

    // Consulta de las tareas de todos los eventos a la vez (para mostrar el avance en la lista).
    match /{path=**}/tareas/{tid} {
      allow read: if autorizado();
    }

    // Lista de compras compartida.
    match /compras/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && compraValida();
    }

    // Estilo compartido (tema, fondo, color y burbujas) y la foto de fondo (imagen reducida como texto).
    match /config/apariencia {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['tema', 'fondo', 'acento', 'burbujas', 'actualizado']);
    }

    match /config/foto {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['data', 'actualizado'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 800000;
    }

    // Categorías de color compartidas (un solo documento con la lista).
    match /config/categorias {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['items', 'actualizado'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 24;
    }

    // Presencia: cada persona escribe solo su propio documento; la pareja los lee para ver quién está conectado.
    match /presencia/{uid} {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'iniciales', 'ultima'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
        && request.resource.data.iniciales is string && request.resource.data.iniciales.size() <= 3;
    }
  }
}
