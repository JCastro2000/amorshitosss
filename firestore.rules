// Reglas de seguridad de Firestore.
//
// - Solo pueden leer y escribir quienes entran con un correo de Google verificado que tenga su
//   documento en la colección "allowed" (un documento por correo, con el correo como ID).
//   Los documentos de "allowed" se crean a mano en la consola de Firebase: la app no puede crearlos.
// - Los eventos son compartidos por todas las personas autorizadas (la pareja).
//
// Se publican en Firebase Console → Firestore Database → Reglas.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verificado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function autorizado() {
      return verificado()
        && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email));
    }

    function eventoValido() {
      let e = request.resource.data;
      return e.titulo is string && e.titulo.size() > 0 && e.titulo.size() <= 120
        && e.fecha is string && e.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /allowed/{email} {
      allow get: if verificado() && request.auth.token.email == email;
    }

    match /eventos/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && eventoValido();
    }

    // Estilo compartido (tema, fondo y color) y la foto de fondo (imagen reducida como texto).
    match /config/apariencia {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['tema', 'fondo', 'acento', 'burbujas', 'actualizado']);
    }

    match /config/foto {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 800000;
    }

    // Lista de compras compartida.
    match /compras/{id} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.comprado is bool;
    }

    // Presencia: cada persona escribe solo su propio documento; la pareja los lee para ver quién está conectado.
    match /presencia/{uid} {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'iniciales', 'ultima'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
        && request.resource.data.iniciales is string && request.resource.data.iniciales.size() <= 3;
    }

    // Categorías de color compartidas (un solo documento con la lista).
    match /config/categorias {
      allow read: if autorizado();
      allow create, update: if autorizado()
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 24;
    }
  }
}
